{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://studypy-backend.onrender.com/api/:path*" },
    { "source": "/run", "destination": "https://studypy-backend.onrender.com/run" },
    { "source": "/links", "destination": "https://studypy-backend.onrender.com/links" },
    { "source": "/search", "destination": "https://studypy-backend.onrender.com/search" },
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ],
  "cleanUrls": true
}
